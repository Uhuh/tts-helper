{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: built app",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["."],
      "preLaunchTask": "app:build",
      "cwd": "${workspaceFolder}"
    }
  ]
}
