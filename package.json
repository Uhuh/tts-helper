{
  "name": "tts-helper",
  "version": "7.0.0",
  "author": {
    "email": "dylanwarren19@gmail.com",
    "name": "Dylan Warren",
    "url": "https://tts-helper.com"
  },
  "license": "LGPL-3.0-or-later",
  "private": true,
  "description": "A local-first desktop TTS queue manager for streamers.",
  "main": "dist-electron/electron/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.main.json && vite build",
    "rebuild:native:electron": "node scripts/rebuild-electron-native.cjs",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "dist": "npm run build && npm run rebuild:native:electron && electron-builder",
    "lint": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "@heroui/react": "^3.0.5",
    "@heroui/styles": "^3.0.5",
    "@twurple/api": "^7.3.0",
    "@twurple/auth": "^7.3.0",
    "@twurple/chat": "^7.3.0",
    "@twurple/eventsub-ws": "^7.3.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "obs-websocket-js": "^5.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.8.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  },
  "build": {
    "appId": "com.panku.tts-helper",
    "productName": "TTS Helper",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "executableArgs": [
        "--no-sandbox",
        "--disable-dev-shm-usage"
      ]
    }
  }
}
